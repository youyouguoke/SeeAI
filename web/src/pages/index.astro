---
/**
 * Language Gateway — 自动语言跳转（noindex）。
 * 优先级：localStorage 手动选择 > 浏览器/系统语言（zh* → zh，其余 → en）。
 * 纯静态实现：内联脚本在绘制前 replace，noscript 兜底给双入口链接。
 */
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SeeAI</title>
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="SeeAI — Understand AI by Seeing It." />
    <script is:inline>
      (function () {
        var lang = null;
        try {
          lang = localStorage.getItem('seeai-lang');
        } catch (e) {}
        if (lang !== 'zh' && lang !== 'en') {
          lang = (navigator.language || '').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en';
        }
        window.location.replace('/' + lang + '/');
      })();
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; text-align: center; padding-top: 40vh; color: #44464e; background: #fbf8fc;">
    <p>
      SeeAI — Understand AI by Seeing It<br />
      <a href="/zh/" style="color: #004ac6;">中文站</a>
      &nbsp;·&nbsp;
      <a href="/en/" style="color: #004ac6;">English</a>
    </p>
  </body>
</html>

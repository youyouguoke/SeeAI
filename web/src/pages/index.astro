---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Language Gateway — 语言门户（noindex，不自动跳转）。
 * 极简：品牌 + 定位 + 双语入口。
 */
---

<BaseLayout
  locale="zh"
  path="/"
  title="SeeAI — Understand AI by Seeing It"
  description="SeeAI — 交互式 AI 概念学习平台。Interactive AI concept learning platform."
  noindex
>
  <section class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-5">
    <div class="text-center max-w-xl anim-fade-up">
      <p class="inline-flex items-center gap-2 font-label text-label text-secondary">
        <span class="w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
        Interactive AI Concepts · 交互式 AI 概念
      </p>
      <h1 class="font-display text-display text-on mt-6 mb-4 tracking-tight">
        See<span class="text-primary">AI</span>
      </h1>
      <p class="font-body text-body text-secondary mb-12">
        Understand AI by seeing how it <em class="font-serif not-italic text-primary">actually</em> works.
        <span class="block mt-1.5">看清 AI 如何<span class="text-primary font-medium">真正</span>运作。</span>
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/zh/"
          lang="zh-CN"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg bg-primary text-on-primary font-title text-title font-medium hover:bg-primary-deep transition-colors"
        >
          中文站
          <span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">arrow_forward</span>
        </a>
        <a
          href="/en/"
          lang="en"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg bg-surface text-on font-title text-title font-medium border border-outline-variant hover:border-outline transition-colors"
        >
          English
          <span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
      <p class="mt-10 text-label text-outline">seeai.site</p>
    </div>
  </section>
</BaseLayout>

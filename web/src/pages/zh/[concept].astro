---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/ontology/Hero.astro';
import Workbench, { type ChainNode } from '../../components/ontology/Workbench.astro';
import IdeaSection from '../../components/ontology/IdeaSection.astro';
import Definition from '../../components/ontology/Definition.astro';
import Scenario from '../../components/ontology/Scenario.astro';
import Misconceptions from '../../components/ontology/Misconceptions.astro';
import Quiz from '../../components/ontology/Quiz.astro';
import FurtherLearning from '../../components/ontology/FurtherLearning.astro';
import { ontologyZh as content } from '../../data/concepts/ontology.zh';
import demo from '../../data/demo/ontology-demo.json';

export async function getStaticPaths() {
  const entries = await getCollection('concepts', (e) => e.data.locale === 'zh' && !e.data.draft);
  return entries.map((e) => ({ params: { concept: e.data.slug } }));
}

const { concept } = Astro.params;
const entry = await getEntry('concepts', `zh/${concept}`);
if (!entry) throw new Error(`Concept not found: zh/${concept}`);
const { Content } = await render(entry);
const fm = entry.data;

const chainNodes: ChainNode[] = demo.nodes.map((n) => ({
  type: n.type,
  label: n.label_zh,
  code: n.code,
  highlight: n.type === 'Property',
}));
const chainRels: string[] = demo.edges.map((e) => e.rel_zh);
---

<BaseLayout
  locale="zh"
  path={`/zh/${fm.slug}`}
  title={`${fm.title} | SeeAI`}
  description={fm.summary}
  alternatePath={`/en/${fm.slug}`}
>
  <Hero
    conceptLabel={fm.concept_label}
    title={fm.title}
    teaser={fm.teaser}
    teaserEmphasis={fm.teaser_emphasis}
    meta={fm.hero_meta.map((text, i) => ({ icon: ['schedule', 'precision_manufacturing', 'verified'][i], text }))}
    langSwitch={{ href: `/en/${fm.slug}`, label: content.further.lang_switch }}
  />

  <Workbench w={content.workbench} chainNodes={chainNodes} chainRels={chainRels} />

  <IdeaSection idea={content.idea}>
    <Content />
  </IdeaSection>

  <Definition d={content.definition} />
  <Scenario s={content.scenario} />
  <Misconceptions m={content.misconceptions} />
  <Quiz q={fm.quiz} />
  <FurtherLearning f={content.further} next={fm.next_concept} locale="zh" />
</BaseLayout>

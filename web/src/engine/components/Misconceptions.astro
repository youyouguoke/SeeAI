---
import type { MisconceptionsBlock } from '../types';

interface Props {
  m: MisconceptionsBlock;
}

const { m } = Astro.props;
---

<section class="max-w-content mx-auto px-5 md:px-8 py-8 border-t border-surface-variant" id="critical">
  <p class="font-label text-label text-secondary font-semibold tracking-wider">{m.eyebrow}</p>
  <h2 class="font-headline text-headline text-on mt-2">{m.title}</h2>
  <p class="text-body text-secondary mt-2 mb-8">{m.intro}</p>

  <div class="grid lg:grid-cols-3 gap-4">
    {
      m.items.map((item) => (
        <div class="bg-surface rounded-xl border border-surface-variant p-6 flex flex-col">
          <div class="flex items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-error text-[1.1rem]" aria-hidden="true">
              cancel
            </span>
            <span class="font-label text-label font-semibold text-error">{m.myth_label}</span>
          </div>
          <p class="text-body text-on font-medium mb-5">{item.myth}</p>

          <div class="flex items-center gap-2 mb-3 mt-auto">
            <span class="material-symbols-outlined text-primary text-[1.1rem]" aria-hidden="true">
              check_circle
            </span>
            <span class="font-label text-label font-semibold text-primary">{m.reality_label}</span>
          </div>
          <p class="text-body text-on">{item.reality}</p>

          <p class="mt-5 pt-4 border-t border-surface-variant text-label text-secondary font-medium">
            {item.tagline}
          </p>
        </div>
      ))
    }
  </div>

  {
    m.cost && (
      <div class="mt-8 rounded-xl border border-surface-variant bg-surface-container p-6 md:p-7 max-w-3xl">
        <h3 class="font-title text-title text-on font-semibold mb-4">{m.cost.title}</h3>
        <ul class="space-y-2 mb-6">
          {m.cost.items.map((item) => (
            <li class="flex items-center gap-2.5 text-body text-on">
              <span class="material-symbols-outlined text-primary text-[1.1rem]" aria-hidden="true">add</span>
              {item}
            </li>
          ))}
        </ul>
        <p class="font-label text-label font-semibold text-secondary mb-2.5">{m.cost.flywheel_title}</p>
        <div class="flex flex-wrap items-center gap-1.5 mb-6">
          {m.cost.flywheel_steps.map((s, i) => (
            <>
              <span class="px-2.5 py-1 rounded-full bg-surface border border-surface-variant text-label text-on">{s}</span>
              {i < m.cost!.flywheel_steps.length - 1 && (
                <span class="material-symbols-outlined text-outline text-[0.9rem]" aria-hidden="true">arrow_forward</span>
              )}
            </>
          ))}
        </div>
        <blockquote class="border-l-2 border-primary pl-4">
          <p class="text-body text-on font-medium">{m.cost.summary}</p>
        </blockquote>
        <p class="text-label text-outline mt-4">{m.cost.discipline}</p>
      </div>
    )
  }
</section>

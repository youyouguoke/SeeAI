---
import type { CaseStudyBlock } from '../types';

interface Props {
  c: CaseStudyBlock;
}

const { c } = Astro.props;
---

<section class="max-w-content mx-auto px-5 md:px-8 py-8 border-t border-surface-variant" id="case-study">
  <p class="font-label text-label text-primary font-semibold tracking-wider">{c.eyebrow}</p>
  <h2 class="font-headline text-headline text-on mt-2">{c.title}</h2>

  <!-- 案例说明（内容纪律：实现路径 ≠ 概念定义） -->
  <div class="mt-6 mb-8 rounded-xl border border-surface-variant bg-surface-container p-5 max-w-3xl">
    <p class="font-label text-label font-bold text-primary mb-1.5">{c.note.label}</p>
    <p class="text-body text-on">{c.note.body}</p>
  </div>

  <!-- 04 步实现路径 -->
  <div class="grid md:grid-cols-2 gap-4 mb-8">
    {
      c.steps.map((s) => (
        <div class="bg-surface rounded-xl border border-surface-variant p-6 flex flex-col">
          <p class="font-mono text-label text-primary font-bold">{s.index}</p>
          <h3 class="font-title text-title text-on font-semibold mt-1.5 mb-2">{s.title}</h3>
          <p class="text-body text-secondary">{s.body}</p>
          <pre class="mt-4 pt-4 border-t border-surface-variant font-mono text-label text-on whitespace-pre-wrap leading-relaxed">{s.diagram.join('\n')}</pre>
        </div>
      ))
    }
  </div>

  <!-- 核心认知 Callout -->
  <div class="rounded-xl border border-primary-container bg-surface-container p-6 md:p-8 max-w-3xl">
    <p class="font-headline text-headline text-primary-deep leading-snug">{c.callout}</p>
  </div>

  <!-- 其他实现路径 -->
  <p class="font-label text-label text-secondary mt-8 mb-2">{c.alt_label}</p>
  <div class="flex flex-wrap gap-2">
    {
      c.alt_items.map((a) => (
        <span class="px-3 py-1 rounded-full bg-surface border border-surface-variant text-label text-on">
          {a}
        </span>
      ))
    }
  </div>
</section>

---
import type { EnterpriseBlock } from '../types';

interface Props {
  e: EnterpriseBlock;
}

const { e } = Astro.props;
---

<section class="max-w-content mx-auto px-5 md:px-8 py-8 border-t border-surface-variant" id="enterprise">
  <p class="font-label text-label text-primary font-semibold tracking-wider">{e.eyebrow}</p>
  <h2 class="font-headline text-headline text-on mt-2">{e.title}</h2>
  <p class="text-body text-secondary mt-2 mb-8 max-w-3xl">{e.intro}</p>

  <!-- 系统层 -->
  <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2 mb-3">
    {
      e.systems.map((s) => (
        <div class="bg-surface rounded-lg border border-surface-variant px-3 py-2.5 text-center">
          <p class="font-mono text-label font-bold text-on">{s.code}</p>
          <p class="text-label text-secondary mt-0.5">{s.knows}</p>
        </div>
      ))
    }
  </div>

  <!-- 连接符 -->
  <div class="flex justify-center py-1" aria-hidden="true">
    <span class="material-symbols-outlined text-outline">arrow_downward</span>
  </div>

  <!-- Ontology 层 -->
  <div class="rounded-xl border border-primary-container bg-surface-container p-5 mb-3">
    <p class="font-title text-title text-primary-deep font-semibold text-center mb-3">{e.ontology_label}</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
      <div class="bg-surface rounded-lg border border-surface-variant px-3 py-2 text-center">
        <p class="font-label font-semibold text-on">Objects</p>
      </div>
      <div class="bg-surface rounded-lg border border-surface-variant px-3 py-2 text-center">
        <p class="font-label font-semibold text-on">Properties</p>
      </div>
      <div class="bg-surface rounded-lg border border-surface-variant px-3 py-2 text-center">
        <p class="font-label font-semibold text-on">Relationships</p>
      </div>
      <div class="bg-surface rounded-lg border border-surface-variant px-3 py-2 text-center">
        <p class="font-label font-semibold text-on">Actions</p>
      </div>
    </div>
    <p class="text-label text-secondary text-center mt-3">{e.note_title} — {e.note_body}</p>
  </div>

  <div class="flex justify-center py-1" aria-hidden="true">
    <span class="material-symbols-outlined text-outline">arrow_downward</span>
  </div>

  <!-- AI 层 -->
  <div class="rounded-xl border border-surface-variant bg-surface px-5 py-3.5 text-center">
    <p class="font-title text-title text-on font-semibold">{e.ai_label}</p>
  </div>

  <!-- Digital Twin 表述（谨慎版） -->
  <blockquote class="max-w-3xl border-l-2 border-primary pl-5 py-1 mt-8">
    <p class="font-headline text-headline text-on leading-snug">{e.twin.quote}</p>
  </blockquote>
  <p class="text-body text-secondary mt-3 max-w-3xl">{e.twin.body}</p>

  <p class="mt-8 pt-5 border-t border-surface-variant text-body text-on font-medium max-w-3xl">
    {e.conclusion}
  </p>
</section>

---
import type { ScenarioBlock } from '../types';

interface Props {
  s: ScenarioBlock;
}

const { s } = Astro.props;
---

<section class="max-w-content mx-auto px-5 md:px-8 py-8 border-t border-surface-variant" id="scenario">
  <p class="font-label text-label text-primary font-semibold tracking-wider">{s.eyebrow}</p>
  <h2 class="font-headline text-headline text-on mt-2 mb-4">{s.title}</h2>
  <p class="text-body text-secondary max-w-2xl mb-8">{s.intro}</p>

  <ol class="space-y-0 max-w-3xl">
    {
      s.levels.map((l, i) => (
        <li class="flex gap-4 relative pb-6 last:pb-0">
          {i < s.levels.length - 1 && (
            <span class="absolute left-[15px] top-8 bottom-0 w-px bg-outline-variant" aria-hidden="true" />
          )}
          <span class="w-8 h-8 rounded-lg bg-surface-container border border-surface-variant text-primary font-mono text-label font-bold flex items-center justify-center shrink-0">
            {l.tag}
          </span>
          <div class="pt-1">
            <h3 class="font-title text-title text-on font-semibold">{l.title}</h3>
            <p class="text-body text-secondary mt-1">{l.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="max-w-3xl mt-8 bg-surface-container border border-primary-container rounded-xl p-6">
    <div class="flex items-start gap-3">
      <span class="material-symbols-outlined text-primary mt-0.5" aria-hidden="true">info</span>
      <div>
        <h3 class="font-label text-label font-semibold text-on mb-1">{s.takeaway_title}</h3>
        <p class="text-body text-on">{s.takeaway_body}</p>
      </div>
    </div>
  </div>
</section>

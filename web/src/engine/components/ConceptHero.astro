---
interface MetaItem {
  icon: string;
  text: string;
}

interface NavChip {
  id: string;
  label: string;
}

interface Props {
  conceptLabel: string;
  title: string;
  teaser: string;
  teaserEmphasis: string;
  meta: { icon: string; text: string }[];
  nav?: NavChip[];
}

const { conceptLabel, title, teaser, teaserEmphasis, meta, nav } = Astro.props;
---

<section class="max-w-content mx-auto px-5 md:px-8 pt-12 pb-10">
  <div class="anim-fade-up">
    <div class="flex flex-wrap items-center gap-3">
      <span class="px-3 py-1 rounded-full bg-primary text-on-primary text-label font-semibold">
        {conceptLabel}
      </span>
      <span class="h-4 w-px bg-outline-variant" aria-hidden="true"></span>
      <span class="text-secondary font-medium text-body">Deep Interactive Module</span>
    </div>

    <h1 class="font-display text-display text-on mt-6 mb-5 max-w-3xl tracking-tight">
      {title}
    </h1>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-body text-secondary">
      {
        meta.map((m, i) => (
          <>
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-primary text-[1.1rem]" aria-hidden="true">
                {m.icon}
              </span>
              <span>{m.text}</span>
            </span>
            {i < meta.length - 1 && <span class="hidden sm:block h-3 w-px bg-outline-variant" aria-hidden="true" />}
          </>
        ))
      }
    </div>

    <p class="font-body text-body text-on font-medium max-w-2xl mt-6">
      {teaser}
      <strong class="block mt-2 font-semibold text-primary">{teaserEmphasis}</strong>
    </p>

    {
      nav && nav.length > 0 && (
        <nav class="flex flex-wrap gap-2 mt-7" aria-label="Section">
          {nav.map((n) => (
            <a
              href={`#${n.id}`}
              class="px-3 py-1.5 rounded-full bg-surface border border-surface-variant text-label text-secondary hover:text-primary hover:border-primary-container transition-colors"
            >
              {n.label}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</section>

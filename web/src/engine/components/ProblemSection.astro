---
import type { ProblemBlock } from '../types';

interface Props {
  p: ProblemBlock;
}

const { p } = Astro.props;
---

{/* Hero 下方轻视觉：Answer ≠ Work */}
{
  p.strip && (
    <section class="max-w-content mx-auto px-5 md:px-8 pt-2 pb-8">
      <div class="rounded-xl border border-surface-variant bg-surface-container p-5 md:p-6">
        <div class="grid sm:grid-cols-[1fr_auto_1fr] gap-5 items-center">
          <div class="text-center sm:text-left">
            <p class="font-mono text-label text-secondary font-bold mb-2">{p.strip.left_label}</p>
            <pre class="font-mono text-label text-on whitespace-pre-wrap leading-relaxed inline-block text-left">{p.strip.left_flow.join('\n')}</pre>
          </div>
          <p class="font-headline text-headline text-error font-semibold text-center">≠</p>
          <div class="text-center sm:text-right">
            <p class="font-mono text-label text-primary font-bold mb-2">{p.strip.right_label}</p>
            <pre class="font-mono text-label text-on whitespace-pre-wrap leading-relaxed inline-block text-left">{p.strip.right_flow.join('\n')}</pre>
          </div>
        </div>
        <p class="mt-4 pt-4 border-t border-surface-variant text-body text-on font-semibold text-center">{p.strip.punchline}</p>
      </div>
    </section>
  )
}

<section class="max-w-content mx-auto px-5 md:px-8 py-8 border-t border-surface-variant" id="problem">
  <p class="font-label text-label text-primary font-semibold tracking-wider">{p.eyebrow}</p>
  <h2 class="font-headline text-headline text-on mt-2 mb-8">{p.title}</h2>

  <!-- 场景卡片：事件 vs 人工 -->
  <div class="grid sm:grid-cols-2 gap-4 mb-4">
    <div class="rounded-xl border border-error/40 bg-surface p-6">
      <p class="font-mono text-label text-error font-bold">{p.event.time}</p>
      <h3 class="font-title text-title text-on font-semibold mt-2">{p.event.title}</h3>
      <p class="text-body text-secondary mt-1.5">{p.event.detail}</p>
    </div>
    <div class="rounded-xl border border-surface-variant bg-surface p-6">
      <h3 class="font-title text-title text-on font-semibold">{p.human.title}</h3>
      <ul class="mt-2.5 space-y-1.5">
        {p.human.items.map((i) => (
          <li class="flex items-center gap-2 text-body text-secondary">
            <span class="material-symbols-outlined text-[1rem] text-outline" aria-hidden="true">person</span>
            {i}
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="text-body text-on font-medium mb-8 max-w-3xl">{p.note}</p>

  <!-- Human Workflow Timeline -->
  <div class="max-w-2xl">
    {
      p.steps.map((s) => (
        <div class="flex gap-4">
          <div class="flex flex-col items-center">
            <span class="w-2.5 h-2.5 rounded-full bg-outline mt-1.5" aria-hidden="true" />
            <span class="w-px flex-1 bg-surface-variant" aria-hidden="true" />
          </div>
          <div class="pb-5 flex-1">
            <p class="font-mono text-label text-secondary">{s.time} · {s.system}</p>
            <p class="text-body text-on font-medium mt-0.5">{s.action}</p>
            <p class="font-label text-label text-outline mt-0.5">{s.status}</p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Chatbot 局限小卡片 -->
  {
    p.chatbot && (
      <div class="mt-6 rounded-xl border border-surface-variant bg-surface p-6 max-w-2xl">
        <p class="font-mono text-label text-secondary font-bold mb-3">CHATBOT</p>
        <div class="grid sm:grid-cols-[1fr_auto_1fr] gap-4 items-center">
          <div class="rounded-lg bg-surface-container border border-surface-variant p-4">
            <p class="text-body text-on">{p.chatbot.user}</p>
          </div>
          <span class="material-symbols-outlined text-outline" aria-hidden="true">arrow_downward</span>
          <div class="rounded-lg bg-surface-container border border-surface-variant p-4">
            <p class="text-body text-secondary">{p.chatbot.bot}</p>
          </div>
        </div>
        <p class="mt-4 pt-3 border-t border-surface-variant text-body text-on font-semibold">{p.chatbot.conclusion}</p>
      </div>
    )
  }

  <!-- Why：数据不缺，缺的是承担工作的主体 -->
  {
    p.why && (
      <div class="mt-8 max-w-3xl">
        <div class="grid sm:grid-cols-3 gap-3">
          {p.why.columns.map((c) => (
            <div class="rounded-xl border border-surface-variant bg-surface p-5 text-center">
              <p class="font-mono text-label text-primary font-bold">{c.label}</p>
              <div class="mt-2.5 space-y-1">
                {c.items.map((i) => (
                  <p class="text-body text-secondary">{i}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="flex justify-center py-2" aria-hidden="true">
          <span class="material-symbols-outlined text-outline">arrow_downward</span>
        </div>
        <p class="text-body text-on font-medium text-center">{p.why.conclusion}</p>
      </div>
    )
  }
</section>

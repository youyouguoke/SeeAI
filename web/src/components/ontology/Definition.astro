---
import type { DefinitionContent } from '../../data/concepts/ontology.types';

interface Props {
  d: DefinitionContent;
}

const { d } = Astro.props;
---

<section class="max-w-content mx-auto px-5 md:px-8 py-8 border-t border-surface-variant" id="definition">
  <p class="font-label text-label text-primary font-semibold tracking-wider">{d.eyebrow}</p>
  <h2 class="font-headline text-headline text-on mt-2 mb-6">{d.title}</h2>

  <blockquote class="max-w-3xl border-l-2 border-primary pl-5 py-1 mb-8">
    <p class="font-headline text-headline text-on leading-snug">{d.quote}</p>
  </blockquote>

  <div class="grid md:grid-cols-2 gap-4 mb-10">
    <div class="bg-surface rounded-xl border border-surface-variant p-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="material-symbols-outlined text-secondary text-[1.1rem]" aria-hidden="true">table_rows</span>
        <h3 class="font-title text-title text-on">{d.db_label}</h3>
      </div>
      <p class="text-body text-secondary">{d.db_body}</p>
    </div>
    <div class="bg-surface-container rounded-xl border border-primary-container p-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="material-symbols-outlined text-primary text-[1.1rem]" aria-hidden="true">hub</span>
        <h3 class="font-title text-title text-primary-deep">{d.onto_label}</h3>
      </div>
      <p class="text-body text-on">{d.onto_body}</p>
    </div>
  </div>

  <p class="font-title text-title text-on font-semibold mb-5">{d.components_label}</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {
      d.components.map((c) => (
        <div
          class:list={[
            'bg-surface rounded-xl border p-5',
            c.layer === 'dynamic' ? 'border-primary-container' : 'border-surface-variant',
          ]}
        >
          <div class="flex items-center justify-between">
            <span
              class:list={[
                'w-9 h-9 rounded-lg flex items-center justify-center',
                c.layer === 'dynamic' ? 'bg-primary-container text-primary-deep' : 'bg-surface-container text-primary',
              ]}
            >
              <span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">
                {c.icon}
              </span>
            </span>
            <span class="text-label text-outline">{c.index}</span>
          </div>
          <h3 class="font-title text-title text-on font-semibold mt-3">{c.name}</h3>
          <p class="font-label text-label text-primary font-mono mt-1">{c.role}</p>
          <p class="text-body text-on mt-2.5">{c.body}</p>
          <p class="text-label text-secondary mt-3 pt-3 border-t border-surface-variant">
            e.g. {c.example}
          </p>
        </div>
      ))
    }
  </div>

  <!-- Relationship vs Action 对照 -->
  <div class="mt-8 bg-surface-container rounded-xl border border-surface-variant p-6 md:p-7">
    <div class="grid sm:grid-cols-2 gap-5">
      <div class="bg-surface rounded-lg border border-surface-variant p-5">
        <p class="font-label text-label font-bold text-secondary">{d.contrast.rel_label}</p>
        <p class="font-label text-label text-secondary mt-0.5">{d.contrast.rel_role}</p>
        <div class="mt-4 flex items-center gap-2 flex-wrap text-body">
          <span class="font-semibold text-on">{d.contrast.rel_from}</span>
          <span class="text-label font-semibold text-accent bg-surface-container px-2 py-0.5 rounded">
            {d.contrast.rel_verb}
          </span>
          <span class="font-semibold text-on">{d.contrast.rel_to}</span>
        </div>
      </div>
      <div class="bg-surface rounded-lg border border-primary-container p-5">
        <p class="font-label text-label font-bold text-primary">{d.contrast.act_label}</p>
        <p class="font-label text-label text-secondary mt-0.5">{d.contrast.act_role}</p>
        <div class="mt-4 flex items-center gap-2 flex-wrap text-body">
          <span class="font-semibold text-on">{d.contrast.act_from}</span>
          <span class="text-label font-semibold text-accent bg-primary-container text-primary-deep px-2 py-0.5 rounded">
            {d.contrast.act_verb}
          </span>
          <span class="font-semibold text-primary">{d.contrast.act_to}</span>
        </div>
      </div>
    </div>
    <p class="mt-5 pt-4 border-t border-surface-variant text-body text-on font-medium text-center">
      {d.contrast.summary}
    </p>
  </div>
</section>

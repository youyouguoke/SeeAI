---
import type { IdeaContent } from '../../data/concepts/ontology.types';

interface Props {
  idea: IdeaContent;
}

const { idea } = Astro.props;
---

<section class="max-w-content mx-auto px-5 md:px-8 py-8 border-t border-surface-variant">
  <p class="font-label text-label text-primary font-semibold tracking-wider">{idea.label}</p>
  <h2 class="font-headline text-headline text-on mt-2 mb-5">{idea.title}</h2>
  <div class="max-w-2xl text-body text-on leading-relaxed">
    <slot />
  </div>

  <!-- 四问级联：What exists → What can happen -->
  <ol class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-3 max-w-4xl">
    {
      idea.questions.map((item, i) => (
        <li class="relative bg-surface rounded-lg border border-surface-variant p-4">
          <span class="absolute top-3 right-3 font-mono text-label text-outline">0{i + 1}</span>
          <p class="text-label text-secondary">{item.q}</p>
          <p
            class:list={[
              'font-title text-title font-semibold mt-1.5',
              i === 3 ? 'text-primary' : 'text-on',
            ]}
          >
            {item.a}
          </p>
        </li>
      ))
    }
  </ol>
</section>

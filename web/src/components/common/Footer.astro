---
import { getStrings, type Locale } from '../../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const year = new Date().getFullYear();
---

<footer class="w-full bg-surface border-t border-surface-variant py-10 mt-24">
  <div class="max-w-content mx-auto px-5 md:px-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p class="text-body text-secondary">
      © {year} SeeAI — {t.footer.tagline}
      <span class="block mt-1 text-label text-outline">{t.footer.note}</span>
    </p>
    <nav class="flex items-center gap-5 text-body text-secondary" aria-label="Footer">
      <a href={`/${locale}/#concept`} class="text-on font-medium hover:text-primary transition-colors">
        {t.footer.allConcepts}
      </a>
      <a href={`/${locale}/#philosophy`} class="hover:text-on transition-colors">
        {t.footer.methodology}
      </a>
      <a href={`/${locale}/privacy/`} class="hover:text-on transition-colors">
        {t.footer.privacy}
      </a>
      <a href={`/${locale}/terms/`} class="hover:text-on transition-colors">
        {t.footer.terms}
      </a>
      <a href="mailto:hello@seeai.site" class="hover:text-on transition-colors">
        {t.footer.contact}
      </a>
    </nav>
  </div>
</footer>

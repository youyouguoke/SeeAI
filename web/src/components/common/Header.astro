---
import { getStrings, localePair, type Locale } from '../../i18n/index';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = getStrings(locale);
import { liveConcepts } from '../../data/concepts';

/** 当前页在另一语言下的等价路径 */
function alternatePath(p: string): string {
  if (p === '/' || p === '/zh' || p === '/en') return p === '/' ? '/' : `/${localePair[locale]}/`;
  return p.replace(/^\/(zh|en)(?=\/|$)/, `/${localePair[locale]}`);
}
const alt = alternatePath(path);
const homePath = `/${locale}/`;
/** 已上线概念（唯一数据源：data/concepts.ts）→ i18n 标签 */
const labelKey: Record<string, 'ontology' | 'digitalEmployee' | 'agent'> = {
  ontology: 'ontology',
  'digital-employee': 'digitalEmployee',
  agent: 'agent',
};
const concepts = liveConcepts.map((c) => ({
  slug: c.slug,
  label: t.header.nav[labelKey[c.slug]] as string,
}));
const activeConcept = concepts.find((c) => path.includes(`/${c.slug}`));
---

<header class="sticky top-0 z-50 w-full bg-surface/90 backdrop-blur-sm border-b border-surface-variant">
  <div class="max-w-content mx-auto px-5 md:px-8 h-16 flex items-center gap-6">
    <a href={homePath} class="flex items-center gap-3 shrink-0" aria-label="SeeAI">
      <span class="font-title text-title font-semibold text-on tracking-tight">
        See<span class="text-primary">AI</span>
      </span>
      <span class="hidden sm:block h-4 w-px bg-outline-variant" aria-hidden="true"></span>
      <span class="hidden sm:inline-block px-2 py-0.5 rounded-full bg-surface-container text-secondary text-label border border-outline-variant">
        {t.header.badge}
      </span>
    </a>

    <nav class="ml-auto flex items-center gap-6" aria-label={t.header.nav.concepts}>
      <div class="relative group/concepts">
        <button
          type="button"
          aria-haspopup="true"
          class:list={[
            'flex items-center gap-1 text-body font-medium pb-0.5 border-b-2 transition-colors',
            activeConcept ? 'text-on border-accent' : 'text-on border-transparent hover:border-outline-variant',
          ]}
        >
          {t.header.nav.concepts}
          <span class="material-symbols-outlined text-[1.1rem] text-secondary" aria-hidden="true">expand_more</span>
        </button>
        <div class="absolute right-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover/concepts:opacity-100 group-hover/concepts:visible group-hover/concepts:translate-y-0 group-focus-within/concepts:opacity-100 group-focus-within/concepts:visible group-focus-within/concepts:translate-y-0 transition-all duration-150">
          <div class="w-60 rounded-xl border border-surface-variant bg-surface shadow-lg p-1.5">
            {
              concepts.map((c) => (
                <a
                  href={`/${locale}/${c.slug}/`}
                  aria-current={path.includes(`/${c.slug}`) ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between px-3 py-2.5 rounded-lg text-body font-medium transition-colors',
                    path.includes(`/${c.slug}`) ? 'bg-primary-container text-primary-deep' : 'text-on hover:bg-surface-container',
                  ]}
                >
                  {c.label}
                  <span class="material-symbols-outlined text-[1.1rem]" aria-hidden="true">arrow_forward</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
      <span class="hidden sm:block h-4 w-px bg-outline-variant" aria-hidden="true"></span>
      <a
        href={alt}
        hreflang={localePair[locale]}
        lang={localePair[locale]}
        data-track-lang={localePair[locale]}
        class="px-2.5 py-1 rounded-lg text-label font-medium text-secondary hover:text-on hover:bg-surface-container transition-colors"
      >
        {locale === 'zh' ? 'English' : '中文'}
      </a>
    </nav>
  </div>
</header>

<script>
  import { track, ANALYTICS_EVENTS } from '../../lib/analytics';
  document.querySelectorAll<HTMLAnchorElement>('a[data-track-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      const to = a.dataset.trackLang;
      try {
        localStorage.setItem('seeai-lang', to ?? '');
      } catch {}
      track(ANALYTICS_EVENTS.LANG_SWITCH, { to });
    });
  });
</script>

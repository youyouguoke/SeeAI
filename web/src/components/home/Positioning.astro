---
export interface PositioningCopy {
  eyebrow: string;
  notTitle: string;
  notIntro: string;
  notItems: { title: string; body: string }[];
  buildTitle: string;
  buildIntro: string;
  buildItems: { title: string; body: string }[];
  principle: string;
  principleIcon: string;
  promises: string[];
}

interface Props {
  c: PositioningCopy;
}

const { c } = Astro.props;
---

<section class="max-w-5xl mx-auto px-5 md:px-8 mt-20" id="philosophy">
  <p class="font-label text-label text-secondary tracking-wider">{c.eyebrow}</p>
  <div class="grid md:grid-cols-2 gap-4 mt-6">
    <div class="bg-surface rounded-xl border border-surface-variant p-7">
      <div class="flex items-center gap-2.5 mb-3">
        <span class="material-symbols-outlined text-error" aria-hidden="true">cancel</span>
        <h2 class="font-title text-title text-on font-semibold">{c.notTitle}</h2>
      </div>
      <p class="text-body text-on mb-6">{c.notIntro}</p>
      <ul class="space-y-4">
        {
          c.notItems.map((i) => (
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-error mt-0.5 text-[1.1rem] shrink-0" aria-hidden="true">
                close
              </span>
              <p class="text-body text-on">
                <strong class="font-semibold">{i.title}</strong> {i.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bg-surface rounded-xl border border-surface-variant p-7">
      <div class="flex items-center gap-2.5 mb-3">
        <span class="material-symbols-outlined text-primary" aria-hidden="true">verified</span>
        <h2 class="font-title text-title text-on font-semibold">{c.buildTitle}</h2>
      </div>
      <p class="text-body text-on mb-6">{c.buildIntro}</p>
      <ul class="space-y-4">
        {
          c.buildItems.map((i) => (
            <li class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-primary mt-0.5 text-[1.1rem] shrink-0" aria-hidden="true">
                check_circle
              </span>
              <p class="text-body text-on">
                <strong class="font-semibold">{i.title}</strong> {i.body}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 pt-4 border-t border-surface-variant flex items-center gap-2 font-label text-label font-semibold text-on">
        <span class="material-symbols-outlined text-primary text-[1.1rem]" aria-hidden="true">
          {c.principleIcon}
        </span>
        {c.principle}
      </p>
    </div>
  </div>
  <p class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-label text-secondary">
    {c.promises.map((p) => <span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-primary" aria-hidden="true"></span>{p}</span>)}
  </p>
</section>

---
export interface HeroCopy {
  label: string;
  titleTop: string;
  titleAccent: string;
  titleBottom: string;
  sub: string;
  ctaPrimary: string;
  ctaPrimaryHref: string;
  ctaSecondary: string;
  ctaSecondaryHref: string;
  meta: string[];
  langNote: string;
}

interface Props {
  c: HeroCopy;
}

const { c } = Astro.props;
---

<section class="max-w-4xl mx-auto px-5 md:px-8 pt-16 pb-12 text-center">
  <div class="anim-fade-up">
    <p class="inline-flex items-center gap-2 font-label text-label text-secondary">
      <span class="w-1.5 h-1.5 rounded-full bg-primary" aria-hidden="true"></span>
      {c.label}
    </p>

    <h1 class="font-display text-display text-on max-w-3xl mx-auto mt-5 mb-6 tracking-tight">
      {c.titleTop}
      <em class="font-serif not-italic text-primary">{c.titleAccent}</em>{c.titleBottom}
    </h1>

    <p class="font-body text-body text-secondary max-w-2xl mx-auto mb-9" set:html={c.sub} />

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
      <a
        href={c.ctaPrimaryHref}
        data-track-cta="hero_primary"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg bg-primary text-on-primary font-title text-title font-medium hover:bg-primary-deep transition-colors"
      >
        {c.ctaPrimary}
        <span class="material-symbols-outlined text-[1.2rem]" aria-hidden="true">arrow_forward</span>
      </a>
      <a
        href={c.ctaSecondaryHref}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg bg-surface text-on font-label text-label font-semibold border border-surface-variant hover:border-outline-variant transition-colors"
      >
        {c.ctaSecondary}
        <span class="material-symbols-outlined text-[1.1rem]" aria-hidden="true">south</span>
      </a>
    </div>

    <p class="text-label text-secondary mb-8">{c.langNote}</p>

    <dl class="flex flex-wrap justify-center gap-x-8 gap-y-3">
      {
        c.meta.map((m) => {
          const [k, v] = m.split('|');
          return (
            <div class="text-left">
              <dt class="font-label text-label text-outline">{k}</dt>
              <dd class="font-title text-title text-on font-medium">{v}</dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>

<script>
  import { track, ANALYTICS_EVENTS } from '../../lib/analytics';
  document.querySelectorAll<HTMLAnchorElement>('a[data-track-cta]').forEach((a) => {
    a.addEventListener('click', () => track(ANALYTICS_EVENTS.CONCEPT_CTA, { source: a.dataset.trackCta }));
  });
</script>
